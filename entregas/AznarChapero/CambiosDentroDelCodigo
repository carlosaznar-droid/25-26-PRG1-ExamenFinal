import java.util.Scanner;

class CalculadoraGeometria {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        String[] historialForma = new String[20];
        double[] historialArea = new double[20];
        double[] historialPerimetroVolumen = new double[20];
        int contadorHistorial = 0;

        boolean salir = false;

        System.out.println("Calculadora Geometrica - Areas y Perimetros");

        while (!salir) {
            System.out.println("[1] Circulo");
            System.out.println("[2] Rectangulo");
            System.out.println("[3] Triangulo");
            System.out.println("[4] Cilindro");
            System.out.println("[5] Ver historial y Salir");
            System.out.print("Seleccione figura: ");
            int opcion = entrada.nextInt();

            if (opcion == 5) {
                System.out.println("Historial de Calculos");
                double areaAcumulada = 0;

                for (int i = 0; i < contadorHistorial; i++) {
                    System.out.println((i + 1) + ". " + historialForma[i]
                            + " -> Area: " + historialArea[i]
                            + ", Perimetro/Volumen: " + historialPerimetroVolumen[i]);
                    areaAcumulada += historialArea[i];
                }

                System.out.println("Area total acumulada: " + areaAcumulada);
                System.out.println("Gracias por usar la calculadora.");
                salir = true;
            } else {
                double valor1 = 0;
                double valor2 = 0;
                boolean calculoRealizado = false;

                if (opcion == 1) {
                    System.out.print("Radio: ");
                    valor1 = entrada.nextDouble();
                    if (valor1 > 0) {
                        double area = 3.14159 * valor1 * valor1;
                        double perimetro = 2 * 3.14159 * valor1;
                        System.out.println("Area: " + area);
                        System.out.println("Perimetro: " + perimetro);
                        calculoRealizado = true;

                        if (contadorHistorial < 20) {
                            historialForma[contadorHistorial] = "Circulo";
                            historialArea[contadorHistorial] = area;
                            historialPerimetroVolumen[contadorHistorial] = perimetro;
                            contadorHistorial++;
                        }
                    } else {
                        System.out.println("Radio invalido");
                    }

                } else if (opcion == 2) {
                    System.out.print("Base: ");
                    valor1 = entrada.nextDouble();
                    System.out.print("Altura: ");
                    valor2 = entrada.nextDouble();
                    if (valor1 > 0 && valor2 > 0) {
                        double area = valor1 * valor2;
                        double perimetro = 2 * (valor1 + valor2);
                        System.out.println("Area: " + area);
                        System.out.println("Perimetro: " + perimetro);
                        calculoRealizado = true;

                        if (contadorHistorial < 20) {
                            historialForma[contadorHistorial] = "Rectangulo";
                            historialArea[contadorHistorial] = area;
                            historialPerimetroVolumen[contadorHistorial] = perimetro;
                            contadorHistorial++;
                        }
                    } else {
                        System.out.println("Dimensiones invalidas");
                    }

                } else if (opcion == 3) {
                    System.out.print("Lado 1: ");
                    valor1 = entrada.nextDouble();
                    System.out.print("Lado 2: ");
                    valor2 = entrada.nextDouble();
                    System.out.print("Lado 3: ");
                    double valor3 = entrada.nextDouble();

                    if (valor1 > 0 && valor2 > 0 && valor3 > 0 &&
                        (valor1 + valor2 > valor3 &&
                         valor1 + valor3 > valor2 &&
                         valor2 + valor3 > valor1)) {

                        double semiperimetro = (valor1 + valor2 + valor3) / 2;
                        double area = Math.sqrt(semiperimetro * (semiperimetro - valor1) * (semiperimetro - valor2) * (semiperimetro - valor3));
                        double perimetro = valor1 + valor2 + valor3;

                        System.out.println("Area: " + area);
                        System.out.println("Perimetro: " + perimetro);
                        calculoRealizado = true;

                        if (contadorHistorial < 20) {
                            historialForma[contadorHistorial] = "Triangulo";
                            historialArea[contadorHistorial] = area;
                            historialPerimetroVolumen[contadorHistorial] = perimetro;
                            contadorHistorial++;
                        }
                    } else {
                        System.out.println("Lados invalidos o no forman un triangulo");
                    }

                } else if (opcion == 4) {
                    System.out.print("Radio: ");
                    valor1 = entrada.nextDouble();
                    System.out.print("Altura: ");
                    valor2 = entrada.nextDouble();

                    if (valor1 > 0 && valor2 > 0) {
                        double areaBase = 3.14159 * valor1 * valor1;
                        double areaLateral = 2 * 3.14159 * valor1 * valor2;
                        double areaTotal = 2 * areaBase + areaLateral;
                        double volumen = areaBase * valor2;

                        System.out.println("Area Superficial: " + areaTotal);
                        System.out.println("Volumen: " + volumen);
                        calculoRealizado = true;

                        if (contadorHistorial < 20) {
                            historialForma[contadorHistorial] = "Cilindro";
                            historialArea[contadorHistorial] = areaTotal;
                            historialPerimetroVolumen[contadorHistorial] = volumen;
                            contadorHistorial++;
                        }
                    } else {
                        System.out.println("Dimensiones invalidas");
                    }

                } else {
                    System.out.println("Opcion no valida");
                }

                if (calculoRealizado) {
                    System.out.println("Calculo completado.");
                }
            }
        }

        entrada.close();
    }
}

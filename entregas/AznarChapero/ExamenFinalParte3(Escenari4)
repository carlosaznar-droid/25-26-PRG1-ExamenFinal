import java.util.Scanner;

class CalculadoraGeometria {

    static String[] historialForma = new String[20];
    static double[] historialArea = new double[20];
    static double[] historialPerimetroVolumen = new double[20];
    static int contadorHistorial = 0;

    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);
        boolean salir = false;

        System.out.println("Calculadora Geometrica - Areas y Perimetros");

        while (!salir) {
            System.out.println("[1] Circulo");
            System.out.println("[2] Rectangulo");
            System.out.println("[3] Triangulo");
            System.out.println("[4] Cilindro");
            System.out.println("[5] Ver historial y Salir");
            System.out.print("Seleccione figura: ");
            int opcion = entrada.nextInt();

            if (opcion == 5) {
                mostrarHistorial();
                salir = true;
            } else if (opcion == 1) {
                calcularCirculo(entrada);
            } else if (opcion == 2) {
                calcularRectangulo(entrada);
            } else if (opcion == 3) {
                calcularTriangulo(entrada);
            } else if (opcion == 4) {
                calcularCilindro(entrada);
            } else {
                System.out.println("Opcion no valida");
            }
        }

        entrada.close();
    }

    static void calcularCirculo(Scanner entrada) {
        System.out.print("Radio: ");
        double valor1 = entrada.nextDouble();

        if (valor1 > 0) {
            double area = 3.14159 * valor1 * valor1;
            double perimetro = 2 * 3.14159 * valor1;

            System.out.println("Area: " + area);
            System.out.println("Perimetro: " + perimetro);

            guardarHistorial("Circulo", area, perimetro);
            System.out.println("Calculo completado.");
        } else {
            System.out.println("Radio invalido");
        }
    }

    static void calcularRectangulo(Scanner entrada) {
        System.out.print("Base: ");
        double base = entrada.nextDouble();
        System.out.print("Altura: ");
        double altura = entrada.nextDouble();

        if (base > 0 && altura > 0) {
            double area = base * altura;
            double perimetro = 2 * (base + altura);

            System.out.println("Area: " + area);
            System.out.println("Perimetro: " + perimetro);

            guardarHistorial("Rectangulo", area, perimetro);
            System.out.println("Calculo completado.");
        } else {
            System.out.println("Dimensiones invalidas");
        }
    }

    static void calcularTriangulo(Scanner entrada) {
        System.out.print("Lado 1: ");
        double a = entrada.nextDouble();
        System.out.print("Lado 2: ");
        double b = entrada.nextDouble();
        System.out.print("Lado 3: ");
        double c = entrada.nextDouble();

        if (a > 0 && b > 0 && c > 0 &&
            a + b > c && a + c > b && b + c > a) {

            double semiperimetro = (a + b + c) / 2;
            double area = Math.sqrt(semiperimetro * (semiperimetro - a) * (semiperimetro - b) * (semiperimetro - c));
            double perimetro = a + b + c;

            System.out.println("Area: " + area);
            System.out.println("Perimetro: " + perimetro);

            guardarHistorial("Triangulo", area, perimetro);
            System.out.println("Calculo completado.");
        } else {
            System.out.println("Lados invalidos o no forman un triangulo");
        }
    }

    static void calcularCilindro(Scanner entrada) {
        System.out.print("Radio: ");
        double valor1 = entrada.nextDouble();
        System.out.print("Altura: ");
        double valor2 = entrada.nextDouble();

        if (valor1 > 0 && valor2 > 0) {
            double areaBase = 3.14159 * valor1 * valor1;
            double areaTotal = 2 * areaBase + 2 * 3.14159 * valor1 * valor2;
            double volumen = areaBase * valor2;

            System.out.println("Area Superficial: " + areaTotal);
            System.out.println("Volumen: " + volumen);

            guardarHistorial("Cilindro", areaTotal, volumen);
            System.out.println("Calculo completado.");
        } else {
            System.out.println("Dimensiones invalidas");
        }
    }

    static void guardarHistorial(String forma, double area, double perVol) {
        if (contadorHistorial < 20) {
            historialForma[contadorHistorial] = forma;
            historialArea[contadorHistorial] = area;
            historialPerimetroVolumen[contadorHistorial] = perVol;
            contadorHistorial++;
        }
    }

    static void mostrarHistorial() {
        System.out.println("Historial de Calculos");
        double total = 0;

        for (int i = 0; i < contadorHistorial; i++) {
            System.out.println((i + 1) + ". " + historialForma[i]
                    + " -> Area: " + historialArea[i]
                    + ", Perimetro/Volumen: " + historialPerimetroVolumen[i]);
            total += historialArea[i];
        }

        System.out.println("Area total acumulada: " + total);
        System.out.println("Gracias por usar la calculadora.");
    }
}
